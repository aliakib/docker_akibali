<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Response Received</title>
    <style>
        body { font-family: Arial, sans-serif; background: #eef2f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); width: 420px; text-align: center; }
        .success { color: #155724; background: #d4edda; padding: 12px; border-radius: 4px; margin-bottom: 15px; }
        ul { text-align: left; background: #f8f9fa; padding: 15px 25px; border-radius: 4px; list-style-type: square; }
        a { display: inline-block; margin-top: 15px; color: #007bff; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <div class="success">
            <h3><%= result.message %></h3>
        </div>
        <h4>Processed Details:</h4>
        <ul>
            <li><strong>Name:</strong> <%= result.received_data.name %></li>
            <li><strong>Email:</strong> <%= result.received_data.email %></li>
            <li><strong>Message:</strong> <%= result.received_data.message %></li>
        </ul>
        <a href="/">← Submit Another Response</a>
    </div>
</body>
</html>